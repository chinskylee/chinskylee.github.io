---
import T from './T.astro';

const navLinks = [
  { href: '/welcome', label: 'nav.welcome' },
  { href: '/blog', label: 'nav.articles' },
  { href: '/archive', label: 'nav.archive' },
  { href: '/subscribe', label: 'nav.subscribe' },
];

const currentPath = Astro.url.pathname;
---

<nav id="site-nav" class="glass-bar fixed top-3 left-3 right-3 md:left-6 md:right-6 z-50 flex justify-between items-center px-3 md:px-5 py-2.5">
  <!-- Mobile Menu Button (Left side) -->
  <button id="mobile-menu-toggle-nav" class="md:hidden p-2 rounded-full text-on-surface hover:bg-black/5 dark:hover:bg-white/10 transition-colors" data-i18n-attr="aria-label:nav.menu_toggle_aria" aria-label="Toggle menu" aria-expanded="false" aria-controls="mobile-menu">
    <span id="menu-icon" class="material-symbols-outlined text-2xl">&#xe5d2;</span>
  </button>
  
  <a href="/" class="hidden md:block font-bold text-lg tracking-widest text-[#705a4a] dark:text-[#f5f4e8] font-['Space_Grotesk'] uppercase rounded-full px-3 py-1 hover:bg-black/5 dark:hover:bg-white/10 transition-colors">
    TERMINAL_V2.0
  </a>
  
  <!-- Spacer for mobile to balance layout -->
  <div class="md:hidden w-10"></div>
  
  <div class="flex items-center gap-2 md:gap-4">
    <div class="hidden md:flex gap-1 items-center">
      {navLinks.map(link => {
        const isActive = currentPath === link.href || currentPath.startsWith(link.href + '/');
        return (
          <a 
            href={link.href}
            class:list={[
              "nav-link font-['Space_Grotesk'] tracking-tight uppercase text-sm lg:text-base px-3 py-1.5 rounded-full transition-colors duration-150",
              isActive 
                ? "bg-primary/12 text-[#705a4a] dark:bg-primary-fixed-dim/15 dark:text-[#dec1ad]"
                : "text-[#79776d] dark:text-[#a9a596] hover:bg-black/5 dark:hover:bg-white/10 hover:text-[#705a4a] dark:hover:text-[#dec1ad]"
            ]}
            aria-current={isActive ? 'page' : undefined}
          >
            <T k={link.label} />
          </a>
        );
      })}
    </div>
    <button
      data-lang-toggle
      class="glass-btn lang-toggle hidden sm:inline-flex items-center justify-center gap-1.5 px-3 py-2 shrink-0"
      type="button"
      title="Language / 语言"
    >
      <span class="material-symbols-outlined text-base text-on-surface shrink-0" style="font-size: 20px; width: 20px; height: 20px;">&#xe8e2;</span>
      <span class="font-label text-sm tracking-widest uppercase text-on-surface w-[38px] text-center notranslate" translate="no">
        <T k="lang.toggle_label" />
      </span>
    </button>
    <button
      aria-label="Switch to dark mode"
      aria-pressed="false"
      class="theme-toggle glass-btn group px-3 py-2 shrink-0 hidden sm:block"
      id="theme-toggle"
      type="button"
      transition:persist
    >
      <span class="inline-flex items-center justify-center gap-1.5 w-full">
        <span class="material-symbols-outlined text-base text-on-surface transition-all duration-150 shrink-0" id="theme-toggle-icon" style="font-size: 20px; width: 20px; height: 20px;">&#xe51c;</span>
        <span class="theme-dot shrink-0" aria-hidden="true"></span>
        <span class="font-label text-sm tracking-widest uppercase text-on-surface w-[38px] text-center relative notranslate" id="theme-toggle-label" translate="no"></span>
      </span>
    </button>
  </div>
</nav>

<script is:inline>
  // Sync icon with current theme immediately after button renders
  (function() {
    var icon = document.getElementById('theme-toggle-icon');
    if (icon && !icon.dataset.synced) {
      var isDark = document.documentElement.classList.contains('dark');
      icon.textContent = isDark ? '\ue518' : '\ue51c';
      icon.dataset.synced = 'true';
    }
  })();
</script>
