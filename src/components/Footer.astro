---
export interface Props {
  noTopMargin?: boolean;
}

const { noTopMargin = false } = Astro.props;
const currentYear = new Date().getFullYear();
---

<footer class:list={[
  "w-full border-t border-[#79776d]/15 dark:border-[#9f9c90]/15 flex items-center justify-center px-6 py-6 gap-4",
  noTopMargin ? "" : "mt-16",
]}>
  <div class="font-['Space_Grotesk'] text-base leading-tight text-[#705a4a] dark:text-[#f5f4e8]">
    © {currentYear} SYSTEM_ERR_NULL // ALL_EQUATIONS_RESERVED
  </div>
</footer>

<button 
  data-i18n-attr="aria-label:footer.back_to_top"
  aria-label="Back to top" 
  class="glass-btn hidden fixed right-6 bottom-8 z-40 text-on-surface px-3 py-3" 
  id="back-to-top" 
  type="button"
>
  <span class="material-symbols-outlined text-base">&#xe5d8;</span>
</button>